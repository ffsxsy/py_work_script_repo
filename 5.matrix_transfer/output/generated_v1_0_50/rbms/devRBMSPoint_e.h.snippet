    kRbms_ScSOHA_DFCLCalSuccFlg,                                          // DFCL模块容量计算成功标志位
    kRbms_ScSOHA_MFCLCalSuccFlg,                                          // MFCL模块容量计算成功标志位
    kRbms_ScSOHA_MFCLPoint1FlgVmax,                                       // Vmax节电芯MFCL模块特征点1
    kRbms_ScSOHA_MFCLPoint1FlgVmin,                                       // Vmin节电芯MFCL模块特征点1
    kRbms_ScSOHA_MFCLPoint2FlgVmax,                                       // Vmax节电芯MFCL模块中特征点2
    kRbms_ScSOHA_MFCLPoint2FlgVmin,                                       // Vmin节电芯MFCL模块特征点2
    kRbms_ScSOHA_MFCLPoint3FlgVmax,                                       // Vmax节电芯MFCL模块中特征点3
    kRbms_ScSOHA_MFCLPoint3FlgVmin,                                       // Vmin节电芯MFCL模块特征点3
    kRbms_ScSOCA_DispSOCState,                                            // 显示SOC跟随策略状态
    kRbms_ScSOCA_TgtSysSOCPct,                                            // Rack目标SOC (%)
    kRbms_ScSOCA_AccuCapAh,                                               // 最近一次累积充放电容量 (Ah)

    //热管理信息
    kRbms_BBMS_WtrTmpCmd,                                                 // 设定温度(℃)
    kRbms_BBMS_cellTmpMax,                                                // 电芯最高温度(℃)
    kRbms_BBMS_cellTmpMin,                                                // 电芯最低温度(℃)
    kRbms_BBMS_cellTmpAvg,                                                // 电芯平均温度(℃)
    kRbms_TMS_OutWtrTmp,                                                  // 出水温度(℃)
    kRbms_TMS_BackWtrTmp,                                                 // 进水温度(℃)
    kRbms_TMS_EnvTmp,                                                     // 环境温度(℃)
    kRbms_TMS_InWtrP,                                                     // 进水水压(Bar)
    kRbms_TMS_OutWtrP,                                                    // 出水水压(Bar)
    kRbms_TMS_BBMSFltLevel,                                               // TMS 故障等级
    kRbms_TMS_BBMSFltCode,                                                // TMS 故障码
    kRbms_BMS_TMSReqMode,                                                 // BMS请求模式
    kRbms_TMS_BMSMode,                                                    // TMS工作模式
    kRbms_TMSNo,                                                          // TMS编号
    kRbms_TMSCoolState,                                                   // TMS制冷状态

    //RBMS故障列表
    kRbms_Fault_Start,                                                    // RBMS故障数组
    kRbms_Fault_End = kRbms_Fault_Start + 25,                             // RBMS故障数组
    kRbms_Data_End,                                                       // RBMS测点结束
} devRBMSPoint_e;
// clang-format on
