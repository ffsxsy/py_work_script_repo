    kBbms_CcBTCD_DchIClrLimLvl3ThdA,                                                           // 放电过流三级恢复阈值

    //温度阈值参数
    kBbms_CcCLTH_ChOvtempLvl1LimDegC,                                                          // 充电过温一级报警阈值
    kBbms_CcCLTH_ChOvtempLvl2LimDegC,                                                          // 充电过温二级报警阈值
    kBbms_CcCLTH_ChOvtempLvl2RcvryLimDegC,                                                     // 充电过温二级恢复阈值
    kBbms_CcCLTH_ChOvtempLvl3LimDegC,                                                          // 充电过温三级报警阈值
    kBbms_CcCLTH_ChOvtempLvl3RcvryLimDegC,                                                     // 充电过温三级恢复阈值
    kBbms_CcCLTH_ChUnderTLvl1LimDegC,                                                          // 充电低温一级报警阈值
    kBbms_CcCLTH_ChUnderTLvl2LimDegC,                                                          // 充电低温二级报警阈值
    kBbms_CcCLTH_ChUnderTLvl2RcvryLimDegC,                                                     // 充电低温二级恢复阈值
    kBbms_CcCLTH_ChUnderTLvl3LimDegC,                                                          // 充电低温三级报警阈值
    kBbms_CcCLTH_ChUnderTLvl3RcvryLimDegC,                                                     // 充电低温三级恢复阈值
    kBbms_CcCLTH_ChOvtempLvl0LimDegC,                                                          // 充电极限过温阈值
    kBbms_CcCLTH_DischOvtempLvl1LimDegC,                                                       // 放电过温一级报警阈值
    kBbms_CcCLTH_DischOvtempLvl2LimDegC,                                                       // 放电过温二级报警阈值
    kBbms_CcCLTH_DischOvtempLvl2RcvryLimDegC,                                                  // 放电过温二级恢复阈值
    kBbms_CcCLTH_DischOvtempLvl3LimDegC,                                                       // 放电过温三级报警阈值
    kBbms_CcCLTH_DischOvtempLvl3RcvryLimDegC,                                                  // 放电过温三级恢复阈值
    kBbms_CcCLTH_DischOvtempLvl0LimDegC,                                                       // 放电极限过温阈值
    kBbms_CcCLTH_CellTempRiseChangeRate,                                                       // 温升过快极限故障阈值
    kBbms_CcCLTH_DischUnderTLvl1LimDegC,                                                       // 放电低温一级报警阈值
    kBbms_CcCLTH_DischUnderTLvl2LimDegC,                                                       // 放电低温二级报警阈值
    kBbms_CcCLTH_DischUnderTLvl2RcvryLimDegC,                                                  // 放电低温二级恢复阈值
    kBbms_CcCLTH_DischUnderTLvl3LimDegC,                                                       // 放电低温三级报警阈值
    kBbms_CcCLTH_DischUnderTLvl3RcvryLimDegC,                                                  // 放电低温三级恢复阈值
    kBbms_CcCLTH_TempDiffLvl1LimDegC,                                                          // 温差过大报警一级阈值
    kBbms_CcCLTH_TempDiffLvl2LimDegC,                                                          // 温差过大报警二级阈值
    kBbms_CcCLTH_TempDiffLvl2RcvryLimDegC,                                                     // 温差过大报警二级恢复阈值
    kBbms_CcCLTH_TempDiffLvl3LimDegC,                                                          // 温差过大报警三级阈值
    kBbms_CcCLTH_TempDiffLvl3RcvryLimDegC,                                                     // 温差过大报警三级恢复阈值

    //SOX阈值参数
    kBbms_CcSOCA_SOCOverLowLvl1EnaThdValPct,                                                   // SOC低一级报警阈值
    kBbms_CcSOCA_SOCOverLowLvl1RecThdValPct,                                                   // SOC低一级恢复阈值
    kBbms_CcSOHA_SOHCOverLowLvl1EnaThdValPct,                                                  // SOH低一级报警阈值
    kBbms_CcSOHA_SOHCOverLowLvl2EnaThdValPct,                                                  // SOH低二级报警阈值
    kBbms_CcSOHA_SOHCOverLowLvl3EnaThdValPct,                                                  // SOH低三级报警阈值
    kBbms_CcSOCA_SOCDiffOverHighEnaThdValPct,                                                  // SOC差异过大报警阈值
    kBbms_CcSOCA_SOCDiffOverHighRecThdValPct,                                                  // SOC差异过大恢复阈值
    kBbms_CcCBCC_CellSelfDischOverHighLvl1EnaThdValPct,                                        // 自放电差异过大一级报警阈值
    kBbms_CcCBCC_CellSelfDischOverHighLvl2EnaThdValPct,                                        // 自放电差异过大二级报警阈值
    kBbms_CcCBCC_CellSelfDischOverHighLvl2RecThdValPct,                                        // 自放电差异过大二级恢复阈值
    kBbms_CcCBCC_CellSelfDischOverHighLvl3EnaThdValPct,                                        // 自放电差异过大三级报警阈值
    kBbms_CcCBCC_CellSelfDischOverHighLvl3RecThdValPct,                                        // 自放电差异过大三级恢复阈值
    kBbms_CcSOCA_OverChgFltEnaThdValPct,                                                       // 过充故障判断阈值

    //AUX阈值参数
    kBbms_CbCBCC_BalFordCmdFlg,                                                                // 均衡禁止命令标定值

    //HMI Control HMI 控制指令
    kBbms_HMI_AlmRst,                                                                          // 清除所有故障信息
    kBbms_HMI_SetEnaIso,                                                                       // 使能/禁止绝缘检测
    kBbms_Reserved_04,                                                                         // 预留占位
    kBbms_HMI_SetEna,                                                                          // 使能/禁止电池串
    kBbms_HMI_EPORst,                                                                          // 清除所有EPO
    kBbms_HMI_EnaIsoManualCtrl,                                                                // 手动控制使能/禁止绝缘检测
    kBbms_HMI_SetCon,                                                                          // 连接/断开电池串
    kBbms_HMI_IDLearnManualCtrl,                                                               // 手动控制Bank执行ID编码
    kBbms_HMI_AutoHvUpConf,                                                                    // 自动上高压设置
    kBbms_HMI_IDLearnDoCtrl,                                                                   // 自动编码DO输出控制
    kBbms_HMI_PmtRkFltNum,                                                                     // 允许运行的最小Rack数量
    kBbms_HMI_PCSComDiagConf,                                                                  // PCS 通讯诊断设置
    kBbms_HMI_LocRemCtl,                                                                       // 控制模式
    kBbms_BBMSNo,                                                                              // 堆编号

    //RBMS/BBMS故障越限次数
    kBbms_FltOvTiNbr_Start,                                                                    // 故障越限次数数组
    kBbms_FltOvTiNbr_End = kBbms_FltOvTiNbr_Start + 200,                                       // 故障越限次数数组
    kBbms_BBMSNo = kBbms_FltOvTiNbr_End,                                                       // 堆编号

    //故障使能数组
    kBbms_FaultEnaFlg_Start,                                                                   // RBMS/BBMS_M/BBMS_A 故障使能数组
    kBbms_FaultEnaFlg_End = kBbms_FaultEnaFlg_Start + 25,                                      // RBMS/BBMS_M/BBMS_A 故障使能数组
    kBbms_Data_End,                                                                            // BBMS测点结束
} devBBMSPoint_e;
